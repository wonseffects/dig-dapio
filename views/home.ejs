<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Cardápio Digital SaaS - Seu Cardápio Online</title>
  <link rel="stylesheet" href="/css/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700;800&family=Playfair+Display:wght@700;900&display=swap" rel="stylesheet">
</head>
<body class="home-page">
  <nav class="navbar">
    <div class="container">
      <div class="logo">🍕 Cardápio Digital</div>
      <div class="nav-links">
        <a href="/login" class="btn-outline">Entrar</a>
        <a href="/cadastro" class="btn-primary">Criar Conta</a>
      </div>
    </div>
  </nav>

  <section class="hero">
    <div class="container">
      <div class="hero-content">
        <h1 class="hero-title">
          Seu Cardápio Digital
          <span class="gradient-text">Moderno e Profissional</span>
        </h1>
        <p class="hero-subtitle">
          Crie um cardápio online personalizado para seu restaurante, pizzaria ou lanchonete. 
          Seus clientes acessam via QR Code e você atualiza quando quiser.
        </p>
        <div class="hero-cta">
          <a href="/cadastro" class="btn-hero">Começar Gratuitamente</a>
          <a href="/login" class="btn-secondary">Já tenho conta</a>
        </div>
      </div>
      <div class="hero-visual">
        <div class="phone-mockup">
          <div class="phone-screen">
            <div class="demo-content">
              <div class="demo-header"></div>
              <div class="demo-item"></div>
              <div class="demo-item"></div>
              <div class="demo-item"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="features">
    <div class="container">
      <h2 class="section-title">Por que usar nosso sistema?</h2>
      <div class="features-grid">
        <div class="feature-card">
          <div class="feature-icon">🎨</div>
          <h3>Personalizável</h3>
          <p>Escolha as cores do seu cardápio e mantenha a identidade visual da sua marca</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">📱</div>
          <h3>QR Code Incluído</h3>
          <p>Gere automaticamente um QR Code para seus clientes acessarem o cardápio</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">⚡</div>
          <h3>Fácil de Usar</h3>
          <p>Interface intuitiva para adicionar e editar produtos em poucos cliques</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">💰</div>
          <h3>Economize</h3>
          <p>Sem necessidade de impressão de cardápios físicos. Atualize quando quiser!</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">🌐</div>
          <h3>Acesso Online</h3>
          <p>Seus clientes acessam de qualquer dispositivo, a qualquer momento</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">🔒</div>
          <h3>Seguro</h3>
          <p>Seus dados protegidos com as melhores práticas de segurança</p>
        </div>
      </div>
    </div>
  </section>

  <section class="cta-section">
    <div class="container">
      <h2>Pronto para começar?</h2>
      <p>Crie sua conta gratuita agora e tenha seu cardápio digital em minutos</p>
      <a href="/cadastro" class="btn-hero">Criar Minha Conta Grátis</a>
    </div>
  </section>

  <footer class="footer">
    <div class="container">
      <p>&copy; 2026 Cardápio Digital SaaS. Todos os direitos reservados.</p>
    </div>
  </footer>

  <script src="/js/animations.js"></script>
</body>
</html>
