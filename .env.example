# Supabase Database URL
# Obtenha em: https://app.supabase.com -> Project Settings -> Database -> Connection String
DATABASE_URL=postgresql://postgres:[SUA-SENHA]@db.[SEU-PROJETO].supabase.co:5432/postgres

# Gere uma string aleatória segura
SESSION_SECRET=mude_isso_para_uma_string_aleatoria_segura

# Porta (Railway define automaticamente)
PORT=3000
